# Backend only. Copy to services/agent/.env (ignored), then configure locally.
# Keep blank to use the deterministic parser. Enable with openrouter after installing requirements-llm.txt.
GROOVE_LLM=
OPENROUTER_API_KEY=
GROOVE_LLM_MODEL=inclusionai/ling-3.2-flash:free
GROOVE_LLM_TIMEOUT=8
GROOVE_LLM_MAX_TOKENS=512
# Optional local speech (requirements-speech.txt):
GROOVE_STT=
GROOVE_STT_MODEL=base.en
