# Backend only. Copy to services/agent/.env (ignored), then configure locally. Never commit keys.
# Keep GROOVE_LLM blank to use the deterministic parser only (exact commands never need a model).
#   GROOVE_LLM=openrouter  -> OpenRouter free models (OPENROUTER_API_KEY)
#   GROOVE_LLM=gemini      -> Gemini; Vertex AI by default (Google Cloud billing/credits)
GROOVE_LLM=
GROOVE_LLM_TIMEOUT=8
GROOVE_LLM_MAX_TOKENS=512

# OpenRouter (GROOVE_LLM=openrouter)
OPENROUTER_API_KEY=
# GROOVE_LLM_MODEL=inclusionai/ling-3.2-flash:free

# Gemini (GROOVE_LLM=gemini). Default model gemini-3.1-flash-lite; override with GROOVE_LLM_MODEL.
# Vertex AI (default): enable the Vertex AI API in the project, then EITHER an API key restricted to
# the Vertex AI API OR a service-account JSON file kept outside the repo.
GROOVE_GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# AI Studio Developer API instead: GROOVE_GEMINI_BACKEND=developer and an AI Studio GOOGLE_API_KEY
# (Google Cloud credits do not fund this API).

# Spoken sound search: research-context so the browser shows spoken searches (needs GROOVE_RESEARCH).
GROOVE_VOICE_RESEARCH=0
# Optional local speech (requirements-speech.txt):
GROOVE_STT=
GROOVE_STT_MODEL=base.en
