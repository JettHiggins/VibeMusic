{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "patch": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "engineRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "engine",
        "preset",
        "parameters",
        "engineRevision"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "previewUrl": {
      "type": "string"
    },
    "score": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "patch",
    "provenance",
    "previewUrl",
    "score"
  ],
  "additionalProperties": false
}
