{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "browser-status"
        },
        "clockId": {
          "type": "string",
          "minLength": 1
        },
        "inputRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available": {
          "type": "boolean"
        },
        "microphone": {
          "type": "string",
          "enum": [
            "off",
            "starting",
            "on",
            "test-signal"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "noisy-room",
            "music"
          ]
        },
        "calibration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "noiseMeasured": {
                  "type": "boolean"
                },
                "noiseFloorDb": {
                  "type": "number"
                },
                "latencySource": {
                  "type": "string",
                  "enum": [
                    "default",
                    "tap-along"
                  ]
                },
                "latencyMs": {
                  "type": "number",
                  "minimum": 0
                },
                "offsetAdjustMs": {
                  "type": "integer",
                  "minimum": -150,
                  "maximum": 150
                }
              },
              "required": [
                "noiseMeasured",
                "noiseFloorDb",
                "latencySource",
                "latencyMs",
                "offsetAdjustMs"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "activeAction": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "calibrate-input",
                    "set-input-profile",
                    "set-input-offset"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "starting",
                    "countdown",
                    "practice",
                    "measuring",
                    "analysing",
                    "reconnecting"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "phase"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "type",
        "clockId",
        "inputRevision",
        "available",
        "microphone",
        "profile",
        "calibration",
        "activeAction"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "browser-action-ack"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "clockId": {
          "type": "string",
          "minLength": 1
        },
        "inputRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "complete",
            "cancelled",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "clockId",
        "inputRevision",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session"
        },
        "session": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tempo": {
              "type": "number",
              "minimum": 40,
              "maximum": 240
            },
            "bars": {
              "type": "number",
              "const": 4
            },
            "beatsPerBar": {
              "type": "number",
              "const": 4
            },
            "stepsPerBeat": {
              "type": "number",
              "const": 4
            },
            "selected": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                }
              },
              "required": [
                "trackId"
              ],
              "additionalProperties": false
            },
            "tracks": {
              "minItems": 4,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "synth-1",
                      "synth-2",
                      "synth-3",
                      "drums"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "muted": {
                    "type": "boolean"
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "patch": {
                    "type": "object",
                    "properties": {
                      "engine": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "preset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "parameters": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "number"
                        }
                      },
                      "engineRevision": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "engine",
                      "preset",
                      "parameters",
                      "engineRevision"
                    ],
                    "additionalProperties": false
                  },
                  "notes": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "step": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "duration": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 64
                        },
                        "midi": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 127
                        },
                        "velocity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "id",
                        "step",
                        "duration",
                        "midi",
                        "velocity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "hits": {
                    "maxItems": 192,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "step": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "lane": {
                          "type": "string",
                          "enum": [
                            "kick",
                            "snare",
                            "closed-hat"
                          ]
                        },
                        "velocity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "id",
                        "step",
                        "lane",
                        "velocity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "muted",
                  "volume",
                  "patch",
                  "notes",
                  "hits"
                ],
                "additionalProperties": false
              }
            },
            "pitchSnap": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "root": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 11
                    },
                    "scale": {
                      "type": "string",
                      "enum": [
                        "major",
                        "minor"
                      ]
                    }
                  },
                  "required": [
                    "root",
                    "scale"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "revision",
            "tempo",
            "bars",
            "beatsPerBar",
            "stepsPerBeat",
            "selected",
            "tracks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "transport"
        },
        "transport": {
          "type": "object",
          "properties": {
            "metronomeEnabled": {
              "type": "boolean"
            },
            "armedStartFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "countInBeatsRemaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "captureErasure": {
              "type": "object",
              "properties": {
                "commandId": {
                  "type": "string",
                  "minLength": 1
                },
                "recordingEpoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "throughFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "trackId": {
                      "type": "string",
                      "enum": [
                        "synth-1",
                        "synth-2",
                        "synth-3",
                        "drums"
                      ]
                    },
                    "lane": {
                      "type": "string",
                      "enum": [
                        "kick",
                        "snare",
                        "closed-hat"
                      ]
                    }
                  },
                  "required": [
                    "trackId"
                  ],
                  "additionalProperties": false
                },
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                }
              },
              "required": [
                "commandId",
                "recordingEpoch",
                "throughFrame",
                "target",
                "step"
              ],
              "additionalProperties": false
            },
            "clockId": {
              "type": "string",
              "minLength": 1
            },
            "sampleRate": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "currentFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "loopStartFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "playing": {
              "type": "boolean"
            },
            "recording": {
              "type": "boolean"
            },
            "pendingCommandIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recordingState": {
              "type": "string",
              "enum": [
                "idle",
                "armed",
                "recording"
              ]
            },
            "recordingStartFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "recordingTarget": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                }
              },
              "required": [
                "trackId"
              ],
              "additionalProperties": false
            },
            "armedTarget": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                }
              },
              "required": [
                "trackId"
              ],
              "additionalProperties": false
            },
            "recordingEpoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "captureStartFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "recordingLoopStartFrame": {
              "type": "number"
            }
          },
          "required": [
            "clockId",
            "sampleRate",
            "currentFrame",
            "loopStartFrame",
            "playing",
            "recording",
            "pendingCommandIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "transport"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ack"
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "applied",
            "rejected"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "commandId",
        "status",
        "revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "utterance"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "clockId": {
          "type": "string",
          "minLength": 1
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duringRecording": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "text",
        "clockId",
        "startFrame",
        "endFrame",
        "duringRecording"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sound-request"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trackId": {
          "type": "string",
          "enum": [
            "synth-1",
            "synth-2",
            "synth-3",
            "drums"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "trackId",
        "description"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cancel-job"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "jobId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "preview-ack"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "ended",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "jobId",
        "candidateId",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "speech-audio"
        },
        "streamId": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clockId": {
          "type": "string",
          "minLength": 1
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 48000
        },
        "encoding": {
          "type": "string",
          "const": "pcm-s16le"
        },
        "data": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "type",
        "streamId",
        "seq",
        "clockId",
        "startFrame",
        "endFrame",
        "sampleRate",
        "encoding",
        "data"
      ],
      "additionalProperties": false
    }
  ]
}
