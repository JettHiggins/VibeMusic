            "type": {
              "type": "string",
              "const": "tempo"
            },
            "bpm": {
              "type": "number",
              "minimum": 40,
              "maximum": 240
            }
          },
          "required": [
            "type",
            "bpm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "clear"
            },
            "target": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
