            },
            "target": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                }
              },
              "required": [
                "trackId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "record"
            },
            "target": {
              "type": "object",
              "properties": {
                "trackId": {
                  "type": "string",
                  "enum": [
                    "synth-1",
                    "synth-2",
                    "synth-3",
                    "drums"
                  ]
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                }
              },
              "required": [
                "trackId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stop-recording"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "play"
            },
