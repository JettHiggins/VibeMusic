{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tempo": {
      "type": "number",
      "minimum": 40,
      "maximum": 240
    },
    "bars": {
      "type": "number",
      "const": 4
    },
    "beatsPerBar": {
      "type": "number",
      "const": 4
    },
    "stepsPerBeat": {
      "type": "number",
      "const": 4
    },
    "selected": {
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "enum": [
            "synth-1",
            "synth-2",
            "synth-3",
            "drums"
          ]
        },
        "lane": {
          "type": "string",
          "enum": [
            "kick",
            "snare",
            "closed-hat"
          ]
        }
      },
      "required": [
        "trackId"
      ],
      "additionalProperties": false
    },
    "tracks": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "synth-1",
              "synth-2",
              "synth-3",
              "drums"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "patch": {
            "type": "object",
            "properties": {
              "engine": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "preset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "engineRevision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "engine",
              "preset",
              "parameters",
              "engineRevision"
            ],
            "additionalProperties": false
          },
          "notes": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "midi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "velocity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "step",
                "duration",
                "midi",
                "velocity"
              ],
              "additionalProperties": false
            }
          },
          "hits": {
            "maxItems": 192,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "lane": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "snare",
                    "closed-hat"
                  ]
                },
                "velocity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "step",
                "lane",
                "velocity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "muted",
          "volume",
          "patch",
          "notes",
          "hits"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "revision",
    "tempo",
    "bars",
    "beatsPerBar",
    "stepsPerBeat",
    "selected",
    "tracks"
  ],
  "additionalProperties": false
}
