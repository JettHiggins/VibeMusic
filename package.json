{
  "name": "voicesynthesizer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @voicesynth/web",
    "build": "npm run build -w @voicesynth/web",
    "check": "node --import tsx scripts/check.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "contracts:export": "node --import tsx scripts/export-contracts.ts",
    "worklet:build": "node --import tsx scripts/build-worklet.ts",
    "predev": "npm run worklet:build",
    "prebuild": "npm run worklet:build",
    "test:integration": "VOICESYNTH_INTEGRATION=1 node --import tsx --test tests/service-integration.test.ts",
    "test:research-integration": "VOICESYNTH_INTEGRATION=1 node --import tsx --test services/agent/tests/integration/research-engine.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
